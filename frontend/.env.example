# =============================================
# Example Environment Variables — SIPANTAU BPS
# =============================================
# Copy this to .env.local and fill in your values.
# NEVER commit .env*.local files to Git!

# Supabase (wajib)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# App URL (untuk redirect reset password, dll)
NEXT_PUBLIC_APP_URL=https://your-app-domain.vercel.app

# ⚠️ SANGAT PENTING: Service Role Key (Admin API)
# Diperlukan agar fitur reset password bisa jalan via backend
# tanpa harus lewat recovery session dari email Supabase.
# Dapatkan dari: Supabase Dashboard > Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMTP / Nodemailer (untuk notifikasi approval/rejection akun)
SMTP_EMAIL=sipantaubpssemarang@gmail.com
SMTP_PASSWORD=your-app-password
